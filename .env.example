APP_NAME=PluQ-I
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=replace-with-a-long-random-secret
APP_TIMEZONE=Asia/Jakarta

# Required for admin-uploaded game icons to be committed to the project repository.
# Use a fine-grained token scoped only to this repository with Contents: Read and write.
# Never commit the real token; configure it only in the private server .env/environment.
GITHUB_UPLOAD_TOKEN=
GITHUB_UPLOAD_REPOSITORY=sulistio95/PluQ-I
GITHUB_UPLOAD_BRANCH=feature/admin-left-sidebar
# Set true only when a trusted reverse proxy strips client-supplied X-Forwarded-Proto.
ADMIN_TRUST_PROXY_HTTPS=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pluq_i
DB_USERNAME=pluq_i_user
DB_PASSWORD=replace-this-password
DB_CHARSET=utf8mb4
SCHEDULER_TOKEN=replace-with-a-separate-random-token
SCHEDULER_BATCH_SIZE=5
SCHEDULER_MAX_RUNTIME_SECONDS=20
CHECKOUT_PAYMENTS_ENABLED=false
SUPPLIER_ORDERS_ENABLED=false
DUITKU_ENV=sandbox
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_PAYMENT_METHOD=
# Invoice expiry in minutes (5–1440); admin API settings may override this value.
DUITKU_EXPIRY_MINUTES=30
DUITKU_RETURN_URL=
DUITKU_CALLBACK_URL=
DIGIFLAZZ_API_URL=https://api.digiflazz.com/v1
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_WEBHOOK_SECRET=
DIGIFLAZZ_TESTING=false
VIPAYMENT_API_URL=https://vip-reseller.co.id/api
VIPAYMENT_API_ID=
VIPAYMENT_API_KEY=
VIPAYMENT_CALLBACK_ALLOWED_IPS=178.248.73.218

# Nickname lookup uses VIPayment Game Feature and the API credentials configured above.

# Google Drive/Sheets monthly bookkeeping backup. OAuth must include drive.file and spreadsheets scopes. Keep disabled until tested.
SETTLEMENT_BACKUP_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
